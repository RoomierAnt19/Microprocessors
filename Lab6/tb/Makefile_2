GHDL  := ghdl
STD   := --std=08 -fsynopsys

TOP       := cpu_testbench_template
TOML_FILE := ../vhdl_ls.toml

# --- RISC-V Toolchain Configuration (Arch Linux) ---
TOOLPREFIX ?= riscv64-elf-
CC      := $(TOOLPREFIX)gcc
OBJCOPY := $(TOOLPREFIX)objcopy
OBJDUMP := $(TOOLPREFIX)objdump

CFLAGS  := -march=rv32i -mabi=ilp32 -nostdlib -nostartfiles

# --- Your Test Programs ---
PROGS := t1_regs t2_branch t3_jump t4_load t5_store cylon cylon_sim lstest lstest_sim

# --- Extract and Resolve Source Files ---
define EXTRACT_SOURCES
import glob, sys, os
try:
	import tomllib
except ImportError:
	try:
		import tomli as tomllib
	except ImportError:
		sys.exit(0)

toml_path = '$(TOML_FILE)'
toml_dir = os.path.dirname(os.path.abspath(toml_path))

with open(toml_path, 'rb') as f:
	data = tomllib.load(f)

files = []
libs = data.get('libraries', {})
for lib_val in libs.values():
	if isinstance(lib_val, dict):
		patterns = lib_val.get('files', [])
	elif isinstance(lib_val, list):
		patterns = lib_val
	else:
		continue

	for pat in patterns:
		matched = glob.glob(pat, root_dir=toml_dir, recursive=True)
		if matched:
			for m in matched:
				abs_m = os.path.join(toml_dir, m)
				files.append(os.path.relpath(abs_m, '.'))
		else:
			abs_p = os.path.normpath(os.path.join(toml_dir, pat))
			if os.path.exists(abs_p):
				files.append(os.path.relpath(abs_p, '.'))

seen = set()
unique_files = [x for x in files if not (x in seen or seen.add(x))]
print(' '.join(unique_files))
endef

export EXTRACT_SOURCES
TOML_SRC := $(shell python3 -c "$$EXTRACT_SOURCES")

LOCAL_SRC := $(shell find src tb -name "*.vhd" 2>/dev/null)
ALL_SRC   := $(sort $(LOCAL_SRC) $(TOML_SRC) axi_memory.vhd cpu_testbench_template.vhd)

.PHONY: all analyze clean debug $(PROGS)

all: $(PROGS)

debug:
	@echo "Resolved source files:"
	@for f in $(ALL_SRC); do echo "  $$f"; done

# Prevent make from deleting intermediate files
.SECONDARY:

%.elf: %.S link.ld
	$(CC) $(CFLAGS) -T link.ld $< -o $@

%.bin: %.elf
	$(OBJCOPY) -O binary $< $@

%.dis: %.elf
	$(OBJDUMP) -D $< > $@

# Robust Hex Generation: Replaces xxd/cut with hexdump
%.hex: %.bin
	hexdump -v -e '1/4 "%08X\n"' $< > $@

%.coe: %.hex
	echo "memory_initialization_radix = 16;" > $@
	echo -n "memory_initialization_vector = " >> $@
	sed '$$d' $< | tr '\n' ',' | sed 's/,/, /g' >> $@
	tail -1 $< | sed 's/$$/;/' >> $@

# --- VHDL Compilation ---
analyze:
	@mkdir -p wave
	$(GHDL) -i $(STD) $(ALL_SRC)
	$(GHDL) -m $(STD) $(TOP)

# --- VHDL Simulation Execution ---
$(PROGS): %: %.hex %.dis analyze
	@echo "==> Running $(TOP) with PROGRAM=$@.hex <=="
	$(GHDL) -r $(STD) $(TOP) -gPROGRAM=$@.hex --wave=wave/$@.ghw

clean:
	$(GHDL) --clean
	rm -rf *.cf wave/ *.elf *.bin *.hex *.coe *.dis
