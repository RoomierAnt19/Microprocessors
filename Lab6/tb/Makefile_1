# CENG 442 Lab 6 test programs.
#
#   make            build every program
#   make t4_load    build just that one
#   make clean      remove everything that is generated
#
# Each program produces four files:
#
#   .dis   the disassembly.  Keep it open.  When the core does nothing, this
#          is how you find out what the first few instructions actually were
#   .hex   one 32 bit word per line, for the axi_memory simulation model
#   .coe   the same words in the format Vivado wants for a block memory,
#          which is what Lab 6 needs
#   .elf   the linked image, if you want to look at it with objdump or gdb
#
# The toolchain prefix defaults to the one on the lab machines' PATH.  For
# the copy that ships with Vitis, override it:
#
#   make TOOLPREFIX=/opt/Xilinx/2025.1/gnu/riscv/lin/riscv64-unknown-elf/\
# x86_64-oesdk-linux/usr/bin/riscv32-xilinx-elf/riscv32-xilinx-elf-

TOOLPREFIX ?= riscv32-unknown-elf-

CC      = $(TOOLPREFIX)gcc
OBJCOPY = $(TOOLPREFIX)objcopy
OBJDUMP = $(TOOLPREFIX)objdump

# zicsr: the CSR instructions are their own extension to the assembler.
CFLAGS  = -march=rv32i_zicsr -mabi=ilp32 -nostdlib -nostartfiles

PROGS = t6_trap trap_cylon trap_cylon_sim

all: $(PROGS)

.PHONY: all clean $(PROGS)

# Keep the .hex, .elf and .bin.  Make would otherwise delete them as
# intermediate files, and the .hex is the one axi_memory reads.
.SECONDARY:

$(PROGS): %: %.dis %.hex %.coe

%.elf: %.S link.ld
	$(CC) $(CFLAGS) -T link.ld $< -o $@

# The board build: the same checks, then the Cylon eye on timer
# interrupts, with the result on the LEDs.
trap_cylon.elf: t6_trap.S link.ld
	$(CC) $(CFLAGS) -DBOARD -T link.ld $< -o $@

# The same, with a step short enough to simulate.
trap_cylon_sim.elf: t6_trap.S link.ld
	$(CC) $(CFLAGS) -DBOARD -DCYLON_TICKS=300 -T link.ld $< -o $@

%.bin: %.elf
	$(OBJCOPY) -O binary $< $@

%.dis: %.elf
	$(OBJDUMP) -D $< > $@

# One 32 bit word per line, lowest address first.  This is what
# axi_memory's INIT_FILE generic reads.
%.hex: %.bin
	xxd -c 4 -g 4 -e $< | cut -d ' ' -f 2 > $@

# The same words, in Vivado's block memory initialisation format.
%.coe: %.hex
	echo "memory_initialization_radix = 16;" > $@
	echo -n "memory_initialization_vector = " >> $@
	sed '$$d' $< | tr '\n' ',' | sed 's/,/, /g' >> $@
	tail -1 $< | sed 's/$$/;/' >> $@

clean:
	rm -f *.elf *.bin *.hex *.coe *.dis
